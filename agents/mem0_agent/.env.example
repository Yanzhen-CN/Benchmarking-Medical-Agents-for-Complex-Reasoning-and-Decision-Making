# LLM (OpenAI-compatible, e.g., Qwen)
# - OPENAI_API_KEY: API key for the OpenAI-compatible endpoint
OPENAI_API_KEY=
# - OPENAI_API_BASE_URL: base URL for the OpenAI-compatible endpoint
OPENAI_API_BASE_URL="https://dashscope-us.aliyuncs.com/compatible-mode/v1"
# - LLM_MODEL: model name used for chat completions
LLM_MODEL=qwen-turbo

# Mem0
# - MEM0_API_KEY: API key for mem0
MEM0_API_KEY=

# Optional scoping (set both or leave both empty)
# - MEM0_ORG_ID: mem0 org id
MEM0_ORG_ID=
# - MEM0_PROJECT_ID: mem0 project id
MEM0_PROJECT_ID=

# Behavior flags
# - MEM0_SYNC_WRITE: 1=sync writes (recommended), 0=async writes
MEM0_SYNC_WRITE=1
# - MEM0_PRINT_IDS: 1=print memory_id on write (debug), 0=off
MEM0_PRINT_IDS=0
# - MEM0_INDEX_WAIT_S: seconds to wait before each question (indexing lag)
MEM0_INDEX_WAIT_S=0

# Agent behavior
# - AGENT_ID: agent identity for memory scoping
AGENT_ID=bench-agent
# - AGENT_APP_ID: app identity for memory scoping
AGENT_APP_ID=medagentbench
# - AGENT_RUN_ID: optional run id override (usually set per task)
AGENT_RUN_ID=
# - MEMORY_TOP_K: number of memories to retrieve
MEMORY_TOP_K=5
# - AGENT_MAX_RECENT_TURNS: max recent dialogue turns to keep in prompt
AGENT_MAX_RECENT_TURNS=6
# - AGENT_STORE_DIALOG: 1=store user/assistant messages
AGENT_STORE_DIALOG=1
# - AGENT_STORE_OBS: 1=store extracted observations
AGENT_STORE_OBS=1
# - AGENT_INCLUDE_MEMORY: 1=include retrieved memory in prompt
AGENT_INCLUDE_MEMORY=1
# - AGENT_RETRIEVAL_POLICY: always | question_only | never
AGENT_RETRIEVAL_POLICY=question_only
